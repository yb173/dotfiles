# Homebrew で入れるもの（シェルと、シェルから使う CLI）。どの Mac にも入れる
# chezmoi apply が、このファイルが変わったときに brew bundle で入れる（run_onchange_before_brew-bundle.sh.tmpl）
# GUI のアプリと好みのツールは Brewfile.apps

# シェルと git
brew "bash" # bash 5。#!/usr/bin/env bash のスクリプトを、macOS の bash 3.2 ではなく bash 5 で動かすため
brew "git"
brew "gh"
brew "ghq"
brew "chezmoi"
brew "starship"
brew "fzf"
brew "zoxide"
brew "neovim"

# 言語のバージョン（mise）と Python のパッケージ（uv）
brew "mise"
brew "uv"

# 検索・JSON・ディレクトリの表示
brew "ripgrep"
brew "jq"
brew "tree"
