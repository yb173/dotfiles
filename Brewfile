# Homebrew で入れるもの。brew bundle で入れる
# 入れたものは、ここに足す。ここにないものは brew bundle cleanup で一覧に出る

# シェルと git
brew "git"
brew "gh"
brew "ghq"
brew "chezmoi"
brew "starship"
brew "fzf"
brew "zoxide"
brew "neovim"

# 言語のバージョン（mise）と Python のパッケージ（uv）
brew "mise"
brew "uv"

# 検索・JSON・ディレクトリの表示
brew "ripgrep"
brew "jq"
brew "tree"

# psql・pg_dump。keg-only なので、.zprofile で PATH に足す
brew "libpq"

# 動画と画像
brew "ffmpeg"
brew "yt-dlp"
brew "webp" # cwebp

# アプリとフォント
cask "ghostty"
cask "karabiner-elements"
cask "font-myricam" # VS Code で使っている
