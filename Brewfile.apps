# Homebrew で入れるもの（GUI のアプリと好みのツール）。chezmoi init で「入れる」と答えた Mac にだけ入れる
# chezmoi apply が、このファイルが変わったときに brew bundle で入れる（run_onchange_before_brew-bundle-apps.sh.tmpl）

# psql・pg_dump。keg-only なので、.zprofile で PATH に足す（入っていれば）
brew "libpq"

# 秘密情報がコミットに入っていないかを調べる（GitHub Actions と同じ gitleaks。push する前に手元で gitleaks git）
brew "gitleaks"

# 動画と画像
brew "ffmpeg"
brew "yt-dlp"
brew "webp" # cwebp

# アプリとフォント
cask "ghostty"
cask "karabiner-elements"
# AeroSpace（タイル型のウィンドウマネージャー）。Homebrew の公式の cask にはなく、作者の tap から入れる
tap "nikitabobko/tap"
cask "nikitabobko/tap/aerospace"
cask "font-myricam" # VS Code で使っている
cask "font-hackgen" # Ghostty で使っている（HackGen35）
