# Ghostty の設定。書ける項目は man 5 ghostty、確かめるのは ghostty +validate-config
# 配色は Ghostty の既定のまま

# 白源（HackGen）の 35 版。英字（Hack）と日本語（源柔ゴシック）の幅が 3:5 で、1:2 の版より英字が大きい
# （Brewfile の font-hackgen）。Nerd Font の記号は Ghostty が最初から持っているので、NF 版は使わない
# MyricaM（VS Code のフォント）は、フォントの中の descender の符号が逆で、Ghostty では上下の行が重なるので使わない
font-family = HackGen35
# iTerm2（MesloLGS NF 18pt）と同じ見た目の大きさ（H の高さが 13.1pt）
font-size = 18

# 左の Option キーを Alt として扱う（fzf の Alt-C などのため）
macos-option-as-alt = left

# クイックターミナル（ホットキーで出し入れするウィンドウ）を、上から画面いっぱいに出す
# F18 は、Karabiner が Control の 2 回押しから送る（karabiner.json）
# global: のキーには、macOS のアクセシビリティの許可が要る
keybind = global:f18=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 100%
# メニューバーのある画面（システム設定 → ディスプレイ で「メイン」にした画面。今は内蔵の画面）に出す。
# 既定の main は、キーボードで操作している画面に出るので、外部ディスプレイにも出る
quick-terminal-screen = macos-menu-bar
# 出し入れするときのアニメーションをなくす
quick-terminal-animation-duration = 0
